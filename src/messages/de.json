    "title": "How It Works",
    "subtitle": "Four simple steps to secure, verified commodity trading",
    "step1": {
      "title": "Register & Verify",
      "description": "Create your company profile and complete KYC/KYB verification to access the platform."
    },
    "step2": {
      "title": "Submit Request",
      "description": "Post a buy request or supply offer with full specifications, quantity, and delivery terms."
    },
    "step3": {
      "title": "Match & Negotiate",
      "description": "Our brokers match compatible parties in private deal rooms with document sharing and video meetings."
    },
    "step4": {
      "title": "Agree & Trade",
      "description": "Sign agreements, finalize terms, and proceed to settlement through your banking channels."
    }
  },
